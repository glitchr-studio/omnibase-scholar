{# The authors, the scholar's own name in bold. #}
{%- set family = scholar.familyName|default(null) -%}
<span class="scholar-authors">{% for author in (publication.authors|default(''))|split(', ') %}{% if family and family in author %}<strong>{{ author }}</strong>{% else %}{{ author }}{% endif %}{{ not loop.last ? ', ' }}{% endfor %}</span>
